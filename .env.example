# Copy to .env and adjust:  cp .env.example .env
# Every variable is OPTIONAL — docker-compose.yml carries the same defaults, so `docker compose up`
# works without a .env file. The secrets below are demo values: change them for anything that is
# not a laptop. Keep MONGO_ROOT_PASSWORD free of URL-reserved characters (@ : / ? # %) because it is
# embedded in the MongoDB connection string.

# --- Application ------------------------------------------------------------------------------
# Spring profile for gym-crm and trainer-workload-service. `dev` = MySQL with auto-created schema
# plus the demo endpoints. (`local` = H2 in-memory; `stg`/`prod` need a pre-provisioned schema.)
APP_PROFILE=dev
# Image names: ${IMAGE_PREFIX}/<service>:${IMAGE_TAG}. Set IMAGE_PREFIX=ghcr.io/<owner>/<repo> and
# run `docker compose pull` to use the images published by CI instead of building locally.
IMAGE_PREFIX=gymcrm
IMAGE_TAG=dev

# --- Secrets ----------------------------------------------------------------------------------
# Shared by gym-crm and trainer-workload-service (min. 32 chars). The demo .http scripts carry a
# token signed with the default below; change it and those tokens stop working.
INTERNAL_JWT_SECRET=demo-shared-inter-service-secret-CHANGE-ME-0123456789
# gym-crm's own user-facing JWT signing key (min. 32 chars)
JWT_SECRET=dev-environment-only-jwt-signing-secret-do-not-reuse-0123456789
# ActiveMQ: broker login used by both services, and the same login for the web console
ACTIVEMQ_USER=admin
ACTIVEMQ_PASSWORD=admin
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=mongo-root-pass
MYSQL_ROOT_PASSWORD=mysql-root-pass
MYSQL_DATABASE=gymcrm_dev
MYSQL_USER=gymcrm_dev
MYSQL_PASSWORD=gymcrm_dev

# --- Host ports (change if something on your machine already uses one) ------------------------
# 127.0.0.1 = reachable from this machine only. Use 0.0.0.0 to expose on the network (not advised).
BIND_ADDRESS=127.0.0.1
DISCOVERY_SERVER_PORT=8761
GYM_CRM_PORT=8080
TRAINER_WORKLOAD_PORT=8082
MONGO_PORT=27017
MYSQL_PORT=3306
ACTIVEMQ_BROKER_PORT=61616
ACTIVEMQ_CONSOLE_PORT=8161

# --- Overrides --------------------------------------------------------------------------------
# The official apache/activemq-classic image is archived on Docker Hub (6.2.0 is its last tag);
# point this at a maintained ActiveMQ Classic image if you need patches. It must honour
# ACTIVEMQ_CONNECTION_USER/PASSWORD and ACTIVEMQ_WEB_USER/PASSWORD (as the official image does).
# ACTIVEMQ_IMAGE=apache/activemq-classic:6.2.0
